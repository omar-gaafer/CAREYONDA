{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://careyonda.local/schemas/environmental-anomaly-research-v1.json",
  "title": "CAREYONDA Model A environmental anomaly research event",
  "description": "Research-only event contract. This is not an API/M2/M4.2 contract. Scores are uncalibrated statistical rankings, not probabilities or hazard severity.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "run_mode",
    "scope",
    "model",
    "event",
    "model_result",
    "explanation_limitations"
  ],
  "properties": {
    "contract_version": { "const": "careyonda.environmental_anomaly_research.v1" },
    "run_mode": { "const": "retrospective_research_only" },
    "scope": {
      "type": "object",
      "required": ["source", "subject", "mission_scope", "intended_use", "not_a"],
      "properties": {
        "source": { "const": "NASA RR-1 processed ISS environmental telemetry" },
        "subject": { "type": "string" },
        "mission_scope": { "type": "string" },
        "intended_use": { "type": "string" },
        "not_a": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "model": {
      "type": "object",
      "required": [
        "model_id", "model_version", "metadata_version", "artifact_created_at_utc",
        "artifact_sha256", "artifact_path", "source_dataset", "dataset_version",
        "dataset_manifest_sha256", "feature_schema_version", "feature_count",
        "estimator_class", "training_random_state"
      ],
      "properties": {
        "model_id": { "type": "string", "minLength": 1 },
        "model_version": { "type": "string", "minLength": 1 },
        "metadata_version": { "type": "string", "minLength": 1 },
        "artifact_created_at_utc": { "type": "string", "format": "date-time" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "artifact_path": { "type": "string", "minLength": 1 },
        "source_dataset": { "type": "string", "minLength": 1 },
        "dataset_version": { "type": "string", "minLength": 1 },
        "dataset_manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "feature_schema_version": { "type": "string", "minLength": 1 },
        "feature_count": { "type": "integer", "minimum": 1 },
        "estimator_class": { "type": "string", "minLength": 1 },
        "training_random_state": { "type": ["integer", "null"] }
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": [
        "sample_ref", "event_time_utc", "split", "feature_evidence_availability",
        "feature_evidence_reference_count", "data_quality", "missing_features",
        "imputed_features", "abstention_reasons"
      ],
      "properties": {
        "sample_ref": { "type": "string", "minLength": 1 },
        "event_time_utc": { "type": "string", "format": "date-time" },
        "split": { "enum": ["train", "validation", "test"] },
        "feature_evidence_availability": { "enum": ["available", "unavailable"] },
        "feature_evidence_reference_count": { "type": "integer", "minimum": 0 },
        "data_quality": { "enum": ["complete_for_model_inputs", "incomplete"] },
        "missing_features": { "type": "array", "items": { "type": "string" } },
        "imputed_features": { "type": "array", "items": { "type": "string" } },
        "abstention_reasons": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "model_result": {
      "type": "object",
      "required": [
        "score_name", "score", "threshold", "threshold_method", "comparison",
        "status", "temporal_persistence_2_of_3"
      ],
      "properties": {
        "score_name": { "const": "isolation_forest_path_length_score" },
        "score": { "type": ["number", "null"] },
        "threshold": { "type": ["number", "null"] },
        "threshold_method": { "const": "training_score_quantile" },
        "comparison": { "const": ">=" },
        "status": { "enum": ["flagged", "not_flagged", "abstained"] },
        "temporal_persistence_2_of_3": { "enum": ["flagged", "not_flagged", "abstained"] }
      },
      "additionalProperties": false
    },
    "explanation_limitations": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
